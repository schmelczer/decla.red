{
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "target": "es6",
    "esModuleInterop": true,
    "strict": true,
    "moduleResolution": "node",
    "ignoreDeprecations": "6.0",
    "skipLibCheck": true,
    "module": "commonjs",
    "lib": ["dom", "es2017"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "typings"]
}
